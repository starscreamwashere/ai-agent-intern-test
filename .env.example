# Copy to .env and fill in. Never commit a real .env.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Model + embedding config (defaults are fine for the free tier)
# "auto" asks the API which models your key can use and picks the best available
# (preferring generous-free-tier models like gemini-2.0-flash). Set a specific id
# to pin it, e.g. GEMINI_MODEL=gemini-2.0-flash or GEMINI_MODEL=gemini-3.6-flash.
GEMINI_MODEL=auto
GEMINI_EMBED_MODEL=auto

# Retrieval settings
KB_TOP_K=5

# Seconds between Gemini generate calls, to stay under the free-tier rate limit
# (~5 requests/min). Lower it if your key has higher quota; 0 disables pacing.
GEMINI_MIN_INTERVAL_S=13

# Embedding backend: "gemini" (needs key) or "tfidf" (offline, deterministic, no key)
EMBED_BACKEND=gemini
